<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	<!-- Assembly -->
	<PropertyGroup>
		<TargetFramework>net11.0-browser</TargetFramework>
		<RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		<AssemblyName>PDFtoImage.WebConverter</AssemblyName>
		<RootNamespace>PDFtoImage.WebConverter</RootNamespace>
		<StartupObject>PDFtoImage.WebConverter.Client.Program</StartupObject>
		<VersionPrefix>$(ProductVersion)</VersionPrefix>
		<VersionSuffix>preview</VersionSuffix>
		<WasmNativeStrip>true</WasmNativeStrip>
		<WasmStripILAfterAOT>true</WasmStripILAfterAOT>
		<InvariantGlobalization>true</InvariantGlobalization>
		<InvariantTimezone>true</InvariantTimezone>
		<BlazorWebAssemblyPreserveCollationData>false</BlazorWebAssemblyPreserveCollationData>
		<TrimMode>full</TrimMode>
		<AssemblyOriginatorKeyFile>WebConverter.snk</AssemblyOriginatorKeyFile>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<WasmEnableThreads>false</WasmEnableThreads>
		<WasmEnableSIMD>true</WasmEnableSIMD>
		<PDFiumUseSystemLibjpeg>true</PDFiumUseSystemLibjpeg>
	</PropertyGroup>

	<!-- C# compiler -->
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<Features>strict</Features>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<NoWarn>CA1416;CS8002</NoWarn>
		<SignAssembly>True</SignAssembly>
	</PropertyGroup>

	<!-- Debug builds -->
	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<VersionSuffix>debug</VersionSuffix>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<EmccCompileOptimizationFlag>-O0 -g3 -s ASSERTIONS=2 -s SAFE_HEAP=0 -s STACK_OVERFLOW_CHECK=1</EmccCompileOptimizationFlag>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'!='Debug'">
		<EmccCompileOptimizationFlag>-Oz -g0 -s ASSERTIONS=0 -s SAFE_HEAP=0 -s STACK_OVERFLOW_CHECK=0</EmccCompileOptimizationFlag>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ByteSize" />
		<PackageReference Include="Markdig.Signed" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
		<PackageReference Include="PatrickJahr.Blazor.FileHandling" />
		<PackageReference Include="PatrickJahr.Blazor.WebShare" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PDFtoImage\PDFtoImage.csproj" />
	</ItemGroup>

	<!-- SkiaSharp 4.152.1 selects its Emscripten 3.1.56 archive for net11.0-browser. -->
	<Target Name="_SelectNet11SkiaSharpNativeArchive"
          BeforeTargets="_PrepareForBrowserWasmBuildNative"
          Condition="'$(TargetFramework)' == 'net11.0-browser'">
		<ItemGroup>
			<_OldSkiaSharpNativeArchive Include="@(NativeFileReference)"
                                  Condition="$([System.String]::Copy('%(NativeFileReference.FullPath)').Replace('\','/').Contains('libSkiaSharp.a/3.1.56/'))" />
			<NativeFileReference Remove="@(_OldSkiaSharpNativeArchive)" />
			<NativeFileReference Include="$(SkiaSharpStaticLibraryPath)\5.0.6\$(_SkiaSharpNativeBinaryType)\libSkiaSharp.a"
                           Condition="'@(_OldSkiaSharpNativeArchive)' != ''" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
		<Content Update="wwwroot\404.html" CopyToOutputDirectory="Always" />
		<EmbeddedResource Include="..\..\README.md" Link="README.md" />
	</ItemGroup>
</Project>