<Project Sdk="MSTest.Sdk/4.4.1">
  <!-- Assembly -->
  <PropertyGroup>
    <TargetFrameworks>net471;net481;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>PDFtoImage.Tests</AssemblyName>
    <RootNamespace>PDFtoImage.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <AssemblyOriginatorKeyFile>Tests.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
	
  <!-- C# compiler -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Features>strict</Features>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <NoWarn>CS0618,CA1416</NoWarn>
    <SignAssembly>True</SignAssembly>
  </PropertyGroup>
	
  <ItemGroup>
    <None Include="Assets\**" />
    <ContentWithTargetPath Include="Assets\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>..\%(RelativeDir)%(Filename)%(Extension)</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>
	
  <ItemGroup>
    <None Remove="SaveOutputInGeneratedFolder.runsettings" />
  </ItemGroup>
	
  <ItemGroup>
    <Content Include="SaveOutputInGeneratedFolder.runsettings">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
	
  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\PDFtoImage\PDFtoImage.csproj" />
    <ProjectReference Include="..\Parallel\Parallel.csproj" Condition="'$(TargetFramework)' != 'net471' and '$(TargetFramework)' != 'net481' and '$(TargetFramework)' != 'net8.0'" />
  </ItemGroup>
	
  <!-- Test dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.GitHubActionsReport" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
		<PackageReference Include="System.Buffers" Condition="'$(TargetFramework)' == 'net471' or '$(TargetFramework)' == 'net481'" />
		<PackageReference Include="System.Memory" Condition="'$(TargetFramework)' == 'net471' or '$(TargetFramework)' == 'net481'" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
  </ItemGroup>
</Project>
